{
  "permissions": {
    "allow": [
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(cd *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(less *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(xargs *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(bun *)",
      "Bash(deno run *)",
      "Bash(go run *)",
      "Bash(*esbuild *)",
      "Bash(*tsx *)",
      "Bash(npx tsc *)",
      "Bash(npx @biomejs/biome check *)",
      "Bash(pnpm check *)",
      "Bash(pnpm check-types *)",
      "Bash(pnpm biome *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git blame*)",
      "Bash(curl -s *)",
      "Bash(curl -I *)",
      "Bash(curl -X GET *)",
      "Bash(gh api -X GET *)",
      "Bash(ps *)",
      "Bash(lsof *)",
      "Bash(top *)",
      "Bash(htop *)",
      "Read(*)",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__claude_ai_Context7__query-docs",
      "mcp__claude_ai_Clerk__clerk_sdk_snippet",
      "WebSearch",
      "WebFetch(*)",
      "mcp__MCP_DOCKER__pull_request_read",
      "Bash(pnpm install:*)",
      "Bash(git add:*)",
      "Bash(cp -r *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.prod)",
      "Read(**/.env.dev)",
      "Read(**/.env.ci)",
      "Read(**/.env.stage)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Read(**/.env.backup)",
      "Read(**/.env.bak)",
      "Read(**/.env.old)",
      "Read(**/.envrc)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.prod)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.ci)",
      "Edit(**/.env.stage)",
      "Edit(**/.env.secret)",
      "Edit(**/.env.secrets)",
      "Edit(**/.env.backup)",
      "Edit(**/.env.bak)",
      "Edit(**/.env.old)",
      "Edit(**/.envrc)"
    ],
    "additionalDirectories": [
      "/private/tmp"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-proposed-rules.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/skill-router-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$(date '+%Y-%m-%d %H:%M:%S') - Skill invoked\" >> .claude/skill-invocations.log"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "apollo@olympus": true,
    "expo@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": false
}
