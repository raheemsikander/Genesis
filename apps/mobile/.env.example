# Mobile app environment (Expo). All vars MUST be prefixed EXPO_PUBLIC_ to be inlined
# into the bundle and reachable at runtime. Copy to .env and fill in real values.
# Validated at startup via src/utils/env.ts.

# Base URL of the Express/oRPC server. On a physical device this must be a LAN IP
# (e.g. http://192.168.1.5:3000), not localhost — localhost resolves to the device itself.
EXPO_PUBLIC_SERVER_URL="http://localhost:3000"

# Clerk publishable key (same value as the web app's NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# development | staging | production (defaults to development)
EXPO_PUBLIC_NODE_ENV="development"

# --- E2E testing (Maestro) ---
# Dedicated Clerk DEV-instance test user. Consumed only by the e2e runner,
# NOT prefixed EXPO_PUBLIC_ and NOT inlined into the app bundle.
# Provision a throwaway user in the Clerk dev instance, then set these.
E2E_CLERK_USER_USERNAME="e2e-testing@example.com"
E2E_CLERK_USER_PASSWORD="replace-with-test-user-password"
