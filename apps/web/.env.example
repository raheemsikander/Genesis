# App
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Auth — Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Error monitoring — Rollbar (optional)
NEXT_PUBLIC_ROLLBAR_CLIENT_TOKEN=

# Product analytics — Mixpanel (optional)
NEXT_PUBLIC_MIXPANEL_TOKEN=

# E2E testing (Playwright + Clerk)
E2E_CLERK_USER_USERNAME=e2e-testing@genesis.com
E2E_CLERK_USER_PASSWORD=e2e-testing-password
