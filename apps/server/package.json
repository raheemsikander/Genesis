{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.integration.config.ts",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"dev": "tsx watch src/index.ts",
		"dev:worker": "tsx watch src/async-tasks/worker.ts",
		"start": "node dist/index.mjs",
		"start:worker": "node dist/async-tasks/worker.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1032.0",
		"@aws-sdk/s3-request-presigner": "^3.1032.0",
		"@bull-board/api": "^7.0.0",
		"@bull-board/express": "^7.0.0",
		"@clerk/express": "^2.1.6",
		"@orpc/contract": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.0.7",
		"@repo/orpc-contracts": "workspace:*",
		"@repo/shared": "workspace:*",
		"@t3-oss/env-core": "catalog:",
		"bullmq": "^5.75.2",
		"cors": "^2.8.5",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"express": "^5.1.0",
		"ioredis": "^5.10.1",
		"pg": "^8.17.1",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"react": "catalog:",
		"resend": "^6.12.2",
		"rollbar": "^3.1.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@orpc/client": "catalog:",
		"@types/cors": "^2.8.17",
		"@types/express": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "^8.16.0",
		"@types/react": "catalog:",
		"@types/supertest": "^7.2.0",
		"drizzle-kit": "^0.31.8",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.2.2",
		"tsdown": "^0.16.5",
		"tsx": "^4.19.2",
		"typescript": "catalog:",
		"vitest": "^4.1.4"
	}
}
