{
	"name": "genesis",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo dev dev:worker",
		"dev:worker": "turbo -F server dev:worker",
		"build": "turbo build",
		"setup": "zx scripts/setup.ts",
		"infra:up": "docker compose up -d --wait",
		"infra:down": "docker compose down",
		"infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
		"infra:test:down": "docker compose -f docker-compose.test.yml down",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"dev:mobile": "turbo -F mobile start",
		"db:push": "turbo -F server db:push",
		"db:studio": "turbo -F server db:studio",
		"db:generate": "turbo -F server db:generate",
		"db:migrate": "turbo -F server db:migrate",
		"test": "turbo test",
		"test:e2e": "pnpm --filter web test:e2e",
		"test:e2e:ui": "pnpm --filter web test:e2e:ui",
		"test:e2e:report": "pnpm --filter web test:e2e:report",
		"test:web": "pnpm --filter web test",
		"test:server": "pnpm --filter server test",
		"test:server:unit": "pnpm --filter server test:unit",
		"test:server:integration": "pnpm infra:test:up && pnpm --filter server test:integration",
		"test:mobile:e2e": "node --env-file-if-exists=apps/mobile/.env apps/mobile/e2e/run.ts",
		"check": "biome check --write .",
		"prepare": "husky",
		"ui:add": "pnpm dlx shadcn@latest add \"$@\" -c packages/ui",
		"ui:add:mobile": "pnpm dlx @react-native-reusables/cli@latest add --yes --cwd apps/mobile",
		"rename": "zx scripts/rename.ts",
		"configure-repo": "zx scripts/configure-repository.ts",
		"verify-deploy": "zx scripts/verify-deploy.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1032.0",
		"@aws-sdk/s3-request-presigner": "^3.1032.0",
		"@clerk/express": "^2.1.5",
		"@clerk/nextjs": "^7.2.3",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.0.7",
		"@t3-oss/env-core": "^0.13.11",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-form": "^1.29.0",
		"@tanstack/react-query": "^5.99.2",
		"bullmq": "^5.75.2",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.8.0",
		"mixpanel-browser": "^2.78.0",
		"next": "^16.2.6",
		"resend": "^6.12.2",
		"svix": "^1.90.0",
		"tailwindcss": "^4.2.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@clack/prompts": "^1.2.0",
		"@clerk/testing": "^2.0.12",
		"@commitlint/config-conventional": "^20.5.0",
		"@tailwindcss/postcss": "^4.2.2",
		"@tanstack/react-query-devtools": "^5.97.0",
		"@types/node": "^25.6.0",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.4",
		"commitlint": "^20.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"tsdown": "^0.21.7",
		"turbo": "^2.9.5",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4",
		"zx": "^8.8.5"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=11.1.2"
	},
	"packageManager": "pnpm@11.1.2"
}
