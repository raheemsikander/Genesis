{
	"name": "genesis",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"dev:worker": "turbo -F server dev:worker",
		"build": "turbo build",
		"infra:up": "docker compose up -d --wait",
		"infra:down": "docker compose down",
		"infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
		"infra:test:down": "docker compose -f docker-compose.test.yml down",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F server db:push",
		"db:studio": "turbo -F server db:studio",
		"db:generate": "turbo -F server db:generate",
		"db:migrate": "turbo -F server db:migrate",
		"test": "turbo test",
		"test:e2e": "pnpm --filter web test:e2e",
		"test:e2e:ui": "pnpm --filter web test:e2e:ui",
		"test:e2e:report": "pnpm --filter web test:e2e:report",
		"test:web": "pnpm --filter web test",
		"test:server": "pnpm --filter server test",
		"test:server:unit": "pnpm --filter server test:unit",
		"test:server:integration": "pnpm infra:test:up && pnpm --filter server test:integration",
		"check": "biome check --write .",
		"prepare": "husky",
		"ui:add": "pnpm dlx shadcn@latest add \"$@\" -c packages/ui"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1028.0",
		"@aws-sdk/s3-request-presigner": "^3.1028.0",
		"@clerk/express": "^2.1.0",
		"@clerk/nextjs": "^7.0.12",
		"@react-email/components": "^1.0.12",
		"@react-email/render": "^2.0.6",
		"@t3-oss/env-core": "^0.13.11",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-form": "^1.28.6",
		"@tanstack/react-query": "^5.97.0",
		"bullmq": "^5.73.3",
		"dotenv": "^17.4.1",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.8.0",
		"next": "^16.2.3",
		"resend": "^6.10.0",
		"svix": "^1.90.0",
		"tailwindcss": "^4.2.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@clerk/testing": "^2.0.12",
		"@commitlint/config-conventional": "^20.5.0",
		"@tailwindcss/postcss": "^4.2.2",
		"@tanstack/react-query-devtools": "^5.97.0",
		"@types/node": "^25.5.2",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-v8": "^4.1.4",
		"commitlint": "^20.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"tsdown": "^0.21.7",
		"turbo": "^2.9.5",
		"typescript": "^6.0.2",
		"vitest": "^4.1.4"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.32.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		],
		"overrides": {
			"@tanstack/query-core": "^5.97.0"
		}
	}
}
